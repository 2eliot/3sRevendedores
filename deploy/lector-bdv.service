# Servicio de systemd para el lector del BDV (proceso aparte de la web).
# 1. Cambia RUTA_DE_LA_WEB por la carpeta de la web (la que tiene app.py) y, si la web no usa «venv», la ruta de Python.
# 2. sudo cp deploy/lector-bdv.service /etc/systemd/system/
#    sudo systemctl daemon-reload && sudo systemctl enable --now lector-bdv
# 3. Ver lo que hace:  journalctl -u lector-bdv -f
# Lee las variables del .env de la web (BDV_LLAVE_CIFRADO, BDV_MAX_CUENTAS, DATABASE_URL...).
[Unit]
Description=Lector del BDV de 3sRevendedores (Referencias)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=RUTA_DE_LA_WEB
ExecStart=RUTA_DE_LA_WEB/venv/bin/python lector_bdv.py
Restart=always
RestartSec=30
# Tope de memoria por si algo se descontrola (el VPS tiene 16 GB)
MemoryMax=8G

[Install]
WantedBy=multi-user.target
